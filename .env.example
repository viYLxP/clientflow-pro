# Copy to .env and change the values. Never commit .env.
# انسخه إلى .env وغيّر القيم. لا ترفع ملف .env أبدًا.

# HMAC key for signing login tokens: at least 32 random characters (e.g. `openssl rand -base64 48`).
# مفتاح توقيع رموز الدخول: 32 حرف عشوائي على الأقل (مثلًا `openssl rand -base64 48`).
JWT_SECRET=

DB_USERNAME=clientflow
DB_PASSWORD=change-me
# Port on your machine for DB tools (DBeaver, pgAdmin). / منفذ قاعدة البيانات على جهازك لأدوات مثل DBeaver.
DB_PORT=5442

# Demo data and demo account passwords (set SEED_DEMO_DATA=false in production).
# بيانات تجريبية وكلمات مرور الحسابات التجريبية (خلّ SEED_DEMO_DATA=false في الإنتاج).
SEED_DEMO_DATA=true
ADMIN_PASSWORD=Admin@12345
SALES_PASSWORD=Sales@12345
# The demo client (faisal@alnoor.example) signs in to the client portal with this.
# العميل التجريبي (faisal@alnoor.example) يدخل بوابة العملاء بهذي.
CLIENT_PASSWORD=Client@12345

APP_PORT=8082
CORS_ORIGINS=http://localhost:8082

# Card and Apple Pay go through MOYASAR or STRIPE; SANDBOX is the built-in test gateway (no real money).
# البطاقة وApple Pay تمر عبر MOYASAR أو STRIPE؛ وSANDBOX هي البوابة التجريبية المدمجة (بدون فلوس حقيقية).
CARD_PAYMENT_PROVIDER=SANDBOX
# The address clients open the app on: invite links point here and gateways send clients back here after paying.
# العنوان اللي يفتح منه العملاء التطبيق: روابط الدعوة تأشر عليه، والبوابات ترجّع العميل له بعد الدفع.
PUBLIC_URL=http://localhost:8082
# Test keys from each provider's dashboard (sk_test_...). Leave empty to use the test gateway for that method.
# مفاتيح تجريبية من لوحة كل مزوّد (sk_test_...). اتركها فاضية عشان تستخدم البوابة التجريبية لهالطريقة.
MOYASAR_SECRET_KEY=
STRIPE_SECRET_KEY=
TABBY_SECRET_KEY=
TABBY_MERCHANT_CODE=
TAMARA_API_URL=https://api-sandbox.tamara.co
TAMARA_API_TOKEN=

# Client invite links stop working after this (e.g. 7d, 48h). / روابط دعوة العملاء توقف بعد هالمدة (مثل 7d أو 48h).
INVITE_VALIDITY=7d
# Per visitor IP, per 10 minutes: contact-form messages, and sign-in / invite / payment attempts.
# لكل IP زائر، كل 10 دقائق: رسائل نموذج التواصل، ومحاولات الدخول والدعوة والدفع.
RATE_LIMIT_INQUIRIES=5
RATE_LIMIT_ATTEMPTS=30
